<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>My Profile</title>

    <link rel="stylesheet"
          href="../public/css/styles.css">

    <link rel="stylesheet"
          href="../public/profile.css">

</head>

<body>

    <%- include("partials/navbar.ejs") %>

    <div class="profile-container">

        <h1>My Profile</h1>

        <% if (typeof message !== "undefined" && message) { %>

            <div class="profile-message">
                <%= message %>
            </div>

        <% } %>

        <div class="profile-card">

            <form action="/profile/update"
                  method="POST">

                <div class="profile-form-group">

                    <label for="username">
                        Username
                    </label>

                    <input
                        type="text"
                        id="username"
                        name="username"
                        value="<%= user.username %>"
                        required
                    >

                </div>

                <div class="profile-form-group">

                    <label for="email">
                        Email
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="<%= user.email %>"
                        required
                    >

                </div>

                <div class="profile-form-group">

                    <label for="contact">
                        Contact
                    </label>

                    <input
                        type="text"
                        id="contact"
                        name="contact"
                        value="<%= user.contact %>"
                        required
                    >

                </div>

                <button
                    type="submit"
                    class="update-profile-btn"
                >
                    Save Changes
                </button>

            </form>

            <div class="profile-card password-card">

    <h2>Change Password</h2>

    <form action="/profile/change-password"
          method="POST">

        <div class="profile-form-group">

            <label for="currentPassword">
                Current Password
            </label>

            <input
                type="password"
                id="currentPassword"
                name="currentPassword"
                required
            >

        </div>

        <div class="profile-form-group">

            <label for="newPassword">
                New Password
            </label>

            <input
                type="password"
                id="newPassword"
                name="newPassword"
                minlength="8"
                required
            >

        </div>

        <div class="profile-form-group">

            <label for="confirmPassword">
                Confirm New Password
            </label>

            <input
                type="password"
                id="confirmPassword"
                name="confirmPassword"
                minlength="8"
                required
            >

        </div>

        <button
            type="submit"
            class="update-profile-btn"
        >
            Change Password
        </button>

    </form>

</div>
        </div>

    </div>

    <%- include("partials/footer.ejs") %>

</body>

</html>