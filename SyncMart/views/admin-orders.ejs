<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Admin Orders - SyncMart</title>

  <link
    rel="stylesheet"
    href="/public/css/styles.css"
  >

  <link
    rel="stylesheet"
    href="/public/admin.css"
  >

</head>

<body>

  <%- include("partials/navbar.ejs") %>


  <div class="admin-container">

    <div class="admin-header">

      <div>

        <h1>Order Management</h1>

        <p>
          View and update customer orders
        </p>

        <div class="order-filter-bar">

  <a
    href="/admin/orders"
    class="<%= statusFilter === 'All' ? 'active-filter' : '' %>"
  >
    All
  </a>

  <a
    href="/admin/orders?status=Pending"
    class="<%= statusFilter === 'Pending' ? 'active-filter' : '' %>"
  >
    Pending
  </a>

  <a
    href="/admin/orders?status=Processing"
    class="<%= statusFilter === 'Processing' ? 'active-filter' : '' %>"
  >
    Processing
  </a>

  <a
    href="/admin/orders?status=Shipped"
    class="<%= statusFilter === 'Shipped' ? 'active-filter' : '' %>"
  >
    Shipped
  </a>

  <a
    href="/admin/orders?status=Delivered"
    class="<%= statusFilter === 'Delivered' ? 'active-filter' : '' %>"
  >
    Delivered
  </a>

</div>
      </div>

      <a
        href="/admin"
        class="add-product-btn"
      >
        Product Management
      </a>

    </div>


    <% if (message) { %>

      <div class="admin-message success">
        <%= message %>
      </div>

    <% } %>


    <div class="admin-table-container">

      <table class="admin-table">

        <thead>

          <tr>

            <th>Order</th>

            <th>Customer</th>

            <th>Email</th>

            <th>Date</th>

            <th>Total</th>

            <th>Status</th>

            <th>Update</th>

          </tr>

        </thead>


        <tbody>

          <% if (orders.length === 0) { %>

            <tr>

              <td colspan="7">
                No orders found.
              </td>

            </tr>

          <% } %>


          <% orders.forEach(function(order) { %>

            <tr>

              <td>
                #<%= order.id %>
              </td>


              <td>
                <%= order.username %>
              </td>


              <td>
                <%= order.email %>
              </td>


              <td>

                <%= new Date(
                  order.order_date
                ).toLocaleDateString() %>

              </td>


              <td>

                $<%= Number(
                  order.total_amount
                ).toFixed(2) %>

              </td>

<td>

  <span class="admin-order-status status-<%= order.status.toLowerCase() %>">
    <%= order.status %>
  </span>

</td>


              <td>

                <form
                  action="/admin/orders/status/<%= order.id %>"
                  method="POST"
                  class="status-form"
                >

                  <select
                    name="status"
                    required
                  >

                    <option
                      value="Pending"
                      <%= order.status === "Pending"
                        ? "selected"
                        : "" %>
                    >
                      Pending
                    </option>


                    <option
                      value="Processing"
                      <%= order.status === "Processing"
                        ? "selected"
                        : "" %>
                    >
                      Processing
                    </option>


                    <option
                      value="Shipped"
                      <%= order.status === "Shipped"
                        ? "selected"
                        : "" %>
                    >
                      Shipped
                    </option>


                    <option
                      value="Delivered"
                      <%= order.status === "Delivered"
                        ? "selected"
                        : "" %>
                    >
                      Delivered
                    </option>

                  </select>


                  <button
                    type="submit"
                    class="edit-btn status-button"
                  >
                    Update
                  </button>

                </form>

              </td>

            </tr>

          <% }) %>

        </tbody>

      </table>

    </div>

  </div>


  <%- include("partials/footer.ejs") %>

</body>

</html>